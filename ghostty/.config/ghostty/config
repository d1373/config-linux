#Window settings
# macos-titlebar-style = hidden
window-inherit-working-directory = true
macos-option-as-alt = true
#window-theme = dark
window-save-state = always
window-width = 1920
window-height = 1080
window-padding-x = 10,10
window-padding-y = 10,0

# Mouse
mouse-hide-while-typing = true
copy-on-select = true

background-opacity = 1.90

# Font and cursor
font-family = Hack Nerd Font
font-size = 14.5
cursor-style = block


# Background / Foreground
foreground = #cdcdcd
background = #0a0a0a

# Cursor
cursor-color = #e8b589
cursor-text = #141415

# Selection
selection-background = #535758
selection-foreground = #cdcdcd

# Normal colors (0-7)
palette = 0=#141415
palette = 1=#d8647e
palette = 2=#7fa563
palette = 3=#e8b589
palette = 4=#6e94b2
palette = 5=#c48282
palette = 6=#b4d4cf
palette = 7=#cdcdcd

# Bright colors (8-15)
palette = 8=#5c5c5c
palette = 9=#e07a92
palette = 10=#9ac27f
palette = 11=#f3be7c
palette = 12=#7e98e8
palette = 13=#bb9dbd
palette = 14=#9bb4bc
palette = 15=#ffffff
